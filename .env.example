# Supabase project (Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Personal access token for the Supabase CLI and Management API
# (npm run gen:types, scripts/provision-worker-secret.sh). Not needed to run the app.
SUPABASE_ACCESS_TOKEN=

# Optional. Public site URL used for canonical links, sitemap.xml and robots.txt.
SITE_URL=

# Optional. Google Tag Manager container ID; leave empty to load no tag.
GTM_ID=

# The edge functions read AHREFS_DR_RATING and WORKER_SECRET from
# `supabase secrets`, not from this file (see README → Setup).
