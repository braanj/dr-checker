{
  // Nuxt generates the base config; `npm run typecheck` (nuxi typecheck)
  // checks the app, server and tests. The Deno edge-function entrypoint is
  // excluded (Deno globals, esm.sh import) — `deno check` covers it.
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "exclude": ["dist", ".data", ".output", "node_modules", "supabase/functions/process-queue/index.ts"]
}
